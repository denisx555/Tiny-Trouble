# Unity создаёт эти папки заново: кеш, временные файлы и готовые сборки.
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/[Cc]odeCoverage/

# Личные файлы редакторов кода и автоматически созданные списки проектов.
.vs/
.idea/
.gradle/
*.csproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Файлы отладки и их служебные .meta не нужны для запуска игры.
# Остальные .meta в Assets сохраняем: они связывают сцены с кодом и ресурсами.
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Журналы, отчёты о сбоях и результаты автоматических проверок.
/*.log
/sysinfo.txt
/mono_crash.*
/crash.dmp
*.stackdump
/[Tt]est[Rr]esults/
/[Tt]est[Rr]esults.xml
/[Tt]est[Rr]esults-*.xml

# Экспортированные пакеты и служебная папка старых инструментов Asset Store.
*.unitypackage
/Assets/AssetStoreTools*

# Личные настройки инструментов, временные записи помощника и секреты.
/.agents/
/.codex/
/.aws/
/.superpowers/sdd/
/.superpowers/brainstorm/
.env
.env.*
# Пример настроек без настоящих секретов можно хранить в Git.
!.env.example

# Служебные файлы операционной системы.
.DS_Store
Thumbs.db
Desktop.ini

# Assets, Packages и ProjectSettings должны оставаться в Git.
# Не исключать все *.dll: установленные библиотеки в Assets/Plugins нужны проекту.
