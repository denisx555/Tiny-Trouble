# Normalize text files and Unity YAML for consistent diffs.
* text=auto
*.cs text eol=lf
*.json text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.meta text eol=lf whitespace=-blank-at-eol
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf whitespace=-blank-at-eol
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.overrideController text eol=lf
*.shader text eol=lf
*.shadergraph text eol=lf
*.hlsl text eol=lf
*.cginc text eol=lf
*.uxml text eol=lf
*.uss text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.psd binary
*.fbx binary
*.blend binary
*.wav binary
*.mp3 binary
*.ogg binary
*.mp4 binary
*.ttf binary
*.otf binary
